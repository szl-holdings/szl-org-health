+/-- Appending a non-negative step keeps every step non-negative (the proof obligation
+    of the dependent field `h_steps_nonneg` for the extended step list). -/
+theorem steps_nonneg_append (l : List ℝ) (h : ∀ ε ∈ l, 0 ≤ ε) (x : ℝ) (hx : 0 ≤ x) :
+    ∀ ε ∈ l ++ [x], 0 ≤ ε := by
+  intro ε hmem
+  rcases List.mem_append.mp hmem with h' | h'
+  · exact h ε h'
+  · rw [List.mem_singleton.mp h']
+    exact hx
+
