+    Induction on `k`. The base case is `sin(π/6) = 1/2`; the step is the
+    half-angle identity `2 - 2 cos θ = 4 sin²(θ/2)`, using `cos θ ≥ 0` on
+    `[0, π/2]` to evaluate `√(4 - 4 sin² θ) = 2 cos θ`. -/
+theorem sideSquared_eq_four_mul_sin_sq (k : ℕ) :
+    sideSquared k = 4 * Real.sin (π / (6 * 2 ^ k)) ^ 2 := by
+  induction k with
+  | zero =>
+    have h : π / (6 * 2 ^ 0) = π / 6 := by norm_num
+    rw [h, Real.sin_pi_div_six]
+    unfold sideSquared
+    norm_num
+  | succ n ih =>
+    have hpow : (0 : ℝ) < 6 * 2 ^ n := by positivity
+    have hone : (1 : ℝ) ≤ 2 ^ n := one_le_pow₀ (by norm_num)
+    have hθ0 : 0 ≤ π / (6 * 2 ^ n) := by positivity
+    have hθle : π / (6 * 2 ^ n) ≤ π / 2 := by
+      rw [div_le_div_iff₀ hpow two_pos]
+      nlinarith [Real.pi_pos]
+    have hcos : 0 ≤ Real.cos (π / (6 * 2 ^ n)) :=
+      Real.cos_nonneg_of_mem_Icc ⟨by linarith [Real.pi_pos], hθle⟩
+    have hhalf : π / (6 * 2 ^ (n + 1)) = π / (6 * 2 ^ n) / 2 := by
+      rw [pow_succ]; ring
+    have hsq : 4 - 4 * Real.sin (π / (6 * 2 ^ n)) ^ 2
+        = (2 * Real.cos (π / (6 * 2 ^ n))) ^ 2 := by
+      linear_combination (-4) * Real.sin_sq_add_cos_sq (π / (6 * 2 ^ n))
+    have hdbl : 2 * (π / (6 * 2 ^ n) / 2) = π / (6 * 2 ^ n) := by ring
+    show 2 - Real.sqrt (4 - sideSquared n) = _
+    rw [ih, hsq, Real.sqrt_sq (by positivity), hhalf, Real.sin_sq_eq_half_sub, hdbl]
+    ring
+
+/-- Closed form of the estimate: `liuHuiPi k = n_k · sin(π / n_k)` with
+    `n_k = 6 · 2^k` (half the perimeter of the inscribed regular `n_k`-gon). -/
+theorem liuHuiPi_eq_mul_sin (k : ℕ) :
+    liuHuiPi k = (6 * 2 ^ k) * Real.sin (π / (6 * 2 ^ k)) := by
+  have hpow : (0 : ℝ) < 6 * 2 ^ k := by positivity
+  have hone : (1 : ℝ) ≤ 2 ^ k := one_le_pow₀ (by norm_num)
+  have hθ0 : 0 ≤ π / (6 * 2 ^ k) := by positivity
+  have hθle : π / (6 * 2 ^ k) ≤ π :=
+    div_le_self Real.pi_pos.le (by linarith)
+  have hsin : 0 ≤ Real.sin (π / (6 * 2 ^ k)) :=
+    Real.sin_nonneg_of_nonneg_of_le_pi hθ0 hθle
+  have h4 : 4 * Real.sin (π / (6 * 2 ^ k)) ^ 2 = (2 * Real.sin (π / (6 * 2 ^ k))) ^ 2 := by
+    ring
+  unfold liuHuiPi sideCount
+  rw [sideSquared_eq_four_mul_sin_sq, h4, Real.sqrt_sq (by positivity)]
+  push_cast
+  ring
+
+/-- `liuHuiPi k = π · sinc(π / (6 · 2^k))`, the form in which the limit is read off. -/
+theorem liuHuiPi_eq_pi_mul_sinc (k : ℕ) :
+    liuHuiPi k = π * Real.sinc (π / (6 * 2 ^ k)) := by
+  have hne : π / (6 * 2 ^ k) ≠ 0 := by positivity
+  rw [liuHuiPi_eq_mul_sin, Real.sinc_of_ne_zero hne]
+  field_simp
+
+/-- **Liu Hui's polygon-doubling estimates converge to `π`.**
+
+    `π / (6 · 2^k) → 0`, `Real.sinc` is continuous with `sinc 0 = 1`, and
+    `liuHuiPi k = π · sinc(π / (6 · 2^k))`. -/
+theorem liuHuiPi_tendsto_pi : Filter.Tendsto liuHuiPi Filter.atTop (nhds π) := by
+  have hpow : Filter.Tendsto (fun k : ℕ => (6 : ℝ) * 2 ^ k) Filter.atTop Filter.atTop :=
+    (tendsto_pow_atTop_atTop_of_one_lt (by norm_num : (1 : ℝ) < 2)).const_mul_atTop
+      (by norm_num)
+  have hθ : Filter.Tendsto (fun k : ℕ => π / (6 * 2 ^ k)) Filter.atTop (nhds 0) :=
+    tendsto_const_nhds.div_atTop hpow
+  have hsinc : Filter.Tendsto (fun k : ℕ => Real.sinc (π / (6 * 2 ^ k)))
+      Filter.atTop (nhds 1) := by
+    have h := (Real.continuous_sinc.tendsto 0).comp hθ
+    rw [Real.sinc_zero] at h
+    exact h
+  have hmul := hsinc.const_mul π
+  rw [mul_one] at hmul
+  exact hmul.congr (fun k => (liuHuiPi_eq_pi_mul_sinc k).symm)
+
+/-- **Liu Hui π convergence (proved; the limit is `π`).**
+
+    The sequence `liuHuiPi` converges. The witness is `L = π`, taken from
+    `liuHuiPi_tendsto_pi`: the half-angle identity, in the squared form
+      `sin²(θ/2) = (1 - cos θ)/2`,
+    links `sideSquared` to `4 sin²(π/n_k)` (`sideSquared_eq_four_mul_sin_sq`),
+    so `liuHuiPi k = n_k · sin(π/n_k)` (`liuHuiPi_eq_mul_sin`), which tends to
+    `π` because `sin x / x → 1` as `x → 0` (Mathlib `Real.continuous_sinc`).
+
+    Classically the sequence is also monotone increasing and bounded above by
+    `π`; that monotonicity is not formalised here and is not used by the proof.
